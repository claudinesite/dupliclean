{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    },
    "api/legal.js": {
      "maxDuration": 10,
      "includeFiles": "dist/*.html"
    }
  },
  "redirects": [
    { "source": "/admin", "destination": "https://dupliclean-admin.sanity.studio/", "permanent": false },
    { "source": "/admin/:path*", "destination": "https://dupliclean-admin.sanity.studio/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/privacy-policy.html", "destination": "/api/legal?page=privacy-policy" },
    { "source": "/terms-of-use.html", "destination": "/api/legal?page=terms-of-use" },
    { "source": "/data-deletion.html", "destination": "/api/legal?page=data-deletion" }
  ]
}
