{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/legal.js": {
      "maxDuration": 10,
      "includeFiles": "dist/*.html"
    },
    "api/content.js": {
      "maxDuration": 10
    },
    "api/begin.js": {
      "maxDuration": 10
    },
    "api/complete.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/admin(?:/.*)?",
      "status": 307,
      "headers": {
        "Location": "https://dupliclean-admin.sanity.studio/",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/(privacy-policy|terms-of-use|data-deletion)\\.html",
      "dest": "/api/legal?page=$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
